<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<AnalyzerLanguage>cs</AnalyzerLanguage>
		<IsRoslynComponent>true</IsRoslynComponent>
		<LangVersion>latest</LangVersion>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<IncludeBuildOutput>true</IncludeBuildOutput>
		<PackageId>EntMap</PackageId>
		<Version>0.0.4</Version>
		<Authors>WssIDs</Authors>
		<Description>Source generator and runtime infrastructure for high-performance mapping</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<!-- Говорим NuGet, что мы сами настроим сборку содержимого для папки analyzers/ -->
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_AddAnalyzersToPackage</TargetsForTfmSpecificContentInPackage>
		<Title>EntMap</Title>
		<PackageIcon>icon.png</PackageIcon>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/WssIDs/EntMap</RepositoryUrl>
		<PackageProjectUrl>https://github.com/WssIDs/EntMap</PackageProjectUrl>
		<PackageTags>Mappers</PackageTags>
		<InterceptorsNamespaces>$(InterceptorsNamespaces);EntMap.Example;EntMap.Generators</InterceptorsNamespaces>
		<Copyright>WssIDs 2026</Copyright>
		<PackageReleaseNotes>Fix generator: Moved mapping logic from runtime to compile time, except for type lookup</PackageReleaseNotes>
	</PropertyGroup>
	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="\" />
		<None Update="icon.png">
		  <Pack>True</Pack>
		  <PackagePath></PackagePath>
		</None>
	</ItemGroup>
	<ItemGroup>
		<CompilerVisibleProperty Include="RootNamespace" />
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
	</ItemGroup>

	<!-- ========================================== -->
	<!-- ЦЕЛЬ УПАКОВКИ ГЕНЕРАТОРА КАК АНАЛИЗАТОРА   -->
	<!-- ========================================== -->
	<Target Name="_AddAnalyzersToPackage" Label="Упаковывает текущую DLL как анализатор в специальную папку NuGet">
		<ItemGroup>
			<TfmSpecificPackageFile Include="$(OutputPath)\$(AssemblyName).dll" PackagePath="analyzers/dotnet/cs" />
		</ItemGroup>
	</Target>
</Project>
